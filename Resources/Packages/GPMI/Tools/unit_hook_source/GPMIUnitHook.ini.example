# Copy this file to either:
#   <game exe folder>\GPMI\GPMIUnitHook.ini
# or:
#   Resources\Packages\GPMI\Core\GPMI\GPMIUnitHook.ini
#
# Required: Godot Object::callp RVA for the target executable.
# Use Tools\unit_hook_source\tools\find_godot_callp.py after every game exe update.
#
# object_callp_rva=0x123456
#
# Optional diagnostic mode. This samples Object::callp method names so we can
# distinguish "wrong hook point" from "unit argument decoding failed".
#
# verbose_calls=1
#
# The native hook captures ImageLoader.unit(type, action, high_resolution), calls
# the original function, then replaces the returned Variant through the separate
# GPMITextureLoader.dll placed next to GPMIUnitHook.dll.
#
# Default inline patch size is 12 bytes for the known Godot 4.3 MSVC callp
# prologue. Increase only if a verified locator/prologue check requires a larger
# whole-instruction overwrite.
#
# object_callp_patch_size=12
